{
  "name": "finwise-ai",
  "version": "1.0.0",
  "description": "FinWise AI – Smart Expense Tracker & Financial Intelligence Platform",
  "scripts": {
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
