    "install:all": "npm install && npm install --prefix server && npm install --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "finance",
    "expense-tracker",
    "ai",
    "groq",
    "chromadb",
    "receipt-ocr"
  ],
