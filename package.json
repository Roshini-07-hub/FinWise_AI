{
  "name": "finwise-ai",
  "version": "1.0.0",
  "type": "module",
  "description": "FinWise AI – Smart Expense Tracker & Financial Intelligence Platform",
  "scripts": {
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "build:client": "npm run build --prefix client",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "chromadb": "^1.10.4",
    "cors": "^2.8.5",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "groq-sdk": "^0.15.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "langsmith": "^0.11.8",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "finance",
    "expense-tracker",
    "ai",
    "groq",
    "chromadb",
    "receipt-ocr"
  ],
  "author": "",
  "license": "MIT"
}
