# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database URI (Optional in dev; fallback to in-memory MongoDB if omitted)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/finwise_ai?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=finwise_super_secure_jwt_token_secret_key_2026

# Groq AI API Key (Get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ChromaDB Vector Database (Optional; resilient embedded vector store fallback included)
CHROMA_SERVER_HOST=
CHROMA_API_KEY=

# Cloud Receipt Storage (Optional; local storage enabled by default)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
